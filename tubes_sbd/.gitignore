# Local environment files
.env
.env.*
!.env.example

# Dependencies
/vendor
/node_modules

# Laravel generated files
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/logs/*.log
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/bootstrap/cache/*.php

# Test and tool caches
.phpunit.result.cache
.pest.result.cache

# Logs and local artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating system and editor files
.DS_Store
Thumbs.db
.comments/
.idea/
.vscode/

# Keep Laravel placeholder files
!bootstrap/cache/.gitignore
!storage/**/.gitignore
